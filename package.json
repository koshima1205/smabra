{
  "name": "gekka-ranbu",
  "private": true,
  "version": "0.1.0",
  "description": "月下乱舞 — CNP（CryptoNinja Partners）と月蝕綺譚のキャラが戦う非公式ファンメイドの 3D プラットフォーム対戦アクション（CNP のパートナー情報は NINJAMCP から MCP 経由で取得）",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-kitan.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-kitan.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:single": "node scripts/fetch-kitan.mjs",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pree2e": "node scripts/fetch-kitan.mjs",
    "e2e": "playwright test",
    "sync:roster": "tsx scripts/sync-roster.ts",
    "mcp:ninja": "node node_modules/ninjamcp/dist/index.js",
    "sync:kitan": "node scripts/fetch-kitan.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.180.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "ninjamcp": "github:omikirin/mcp#ebc23931dc0e383fb3c58c390f258e24305a9a37"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
